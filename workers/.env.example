# --- Database ---
# Neon connection string used by the workers at runtime. The pooled endpoint is fine here.
DATABASE_URL="postgres://user:password@ep-xxxx-pooler.us-east-2.aws.neon.tech/orebase?sslmode=require"

# --- AWS (S3 document corpus + Textract OCR) ---
S3_BUCKET="orebase-documents"
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID="AKIA..."
AWS_SECRET_ACCESS_KEY="..."

# --- AI providers ---
VOYAGE_API_KEY="pa-..."          # embeddings (voyage-4, 1024-dim)
ANTHROPIC_API_KEY="sk-ant-..."   # extraction + chat
EXTRACT_HAIKU_MODEL="claude-haiku-4-5"
EXTRACT_SONNET_MODEL="claude-sonnet-4-5"
# Extractor refuses new jobs once spend in app.extraction_costs hits either cap.
EXTRACTION_DAILY_CAP_USD="5"
EXTRACTION_MONTHLY_CAP_USD="50"
# Full numeric extract auto-runs for watchlisted entities and filings newer than this.
EXTRACT_AUTO_MONTHS="18"
EXTRACT_USE_BATCH="0"

# --- SEC EDGAR ---
# SEC fair-access requires a descriptive User-Agent that includes a contact email.
EDGAR_USER_AGENT="OreBase/0.1 (you@example.com)"

# --- SEDAR+ (incremental only until backfill is explicitly confirmed) ---
SEDAR_PROFILE_DIR="~/.sedar_profile"
SEDAR_HEADFUL="0"
SEDAR_DAILY_FETCH_CAP="20"
SEDAR_JSON_SEARCH_URL=""
SEDAR_JSON_SEARCH_METHOD="POST"
# Paste the DevTools XHR body. Placeholders: {document_type} {date_from} {date_to} {offset} {page} {limit} {page_size}
SEDAR_JSON_SEARCH_BODY=""
SEDAR_CHALLENGE_SNS_ARN=""
SEDAR_ALERT_WEBHOOK_SECRET=""
SSM_PREFIX=""

# --- Alerts ---
RESEND_API_KEY=""
ALERT_FROM_EMAIL=""

# --- Newswires ---
NEWSWIRE_FEEDS="https://www.globenewswire.com/RssFeed/subjectcode/26-Mining/feedTitle/GlobeNewswire%20-%20Mining,https://www.newsfilecorp.com/rss/newsfile-all"

# --- CloudWatch (enable on the EC2 box) ---
CLOUDWATCH_METRICS="0"
CLOUDWATCH_NAMESPACE="OreBase"

# --- Diagnostics ---
# Set to 1/true to enable dev-only debug logging on ingestion/processing data flows.
DEBUG="0"
