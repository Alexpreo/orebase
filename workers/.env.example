# --- Database ---
# Neon connection string used by the workers at runtime. The pooled endpoint is fine here.
DATABASE_URL="postgres://user:password@ep-xxxx-pooler.us-east-2.aws.neon.tech/orebase?sslmode=require"

# --- AWS (S3 document corpus + Textract OCR) ---
S3_BUCKET="orebase-documents"
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID="AKIA..."
AWS_SECRET_ACCESS_KEY="..."

# --- AI providers ---
VOYAGE_API_KEY="pa-..."          # embeddings (voyage-3, 1024-dim)
ANTHROPIC_API_KEY="sk-ant-..."   # extraction + chat (used in later phases)

# --- SEC EDGAR ---
# SEC fair-access requires a descriptive User-Agent that includes a contact email.
EDGAR_USER_AGENT="OreBase/0.1 (you@example.com)"

# --- Diagnostics ---
# Set to 1/true to enable dev-only debug logging on ingestion/processing data flows.
DEBUG="0"
