# dbmate reads DATABASE_URL to run migrations.
# Use the Neon DIRECT / UNPOOLED connection string here (not the pooled -pooler host):
# migrations run DDL in transactions, and the PgBouncer pooled endpoint does not support
# all session-level features dbmate relies on. The pooled URL is for the web app runtime.
#
# Format: postgres://USER:PASSWORD@HOST/DBNAME?sslmode=require
DATABASE_URL="postgres://user:password@ep-xxxx.us-east-2.aws.neon.tech/orebase?sslmode=require"

# Optional: where dbmate writes the tracked schema snapshot and where it looks for migrations.
# Defaults already match this repo layout, shown here for clarity.
DBMATE_MIGRATIONS_DIR="./migrations"
DBMATE_SCHEMA_FILE="./schema.sql"
